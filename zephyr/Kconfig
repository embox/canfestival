# CanFestival CANopen stack - Zephyr module configuration
#
# Written by Edouard TISSERANT
# SPDX-License-Identifier: LGPL-2.1-or-later

config ZEPHYR_CANFESTIVAL_MODULE
	bool

config CANFESTIVAL
	bool "CanFestival CANopen stack"
	depends on ZEPHYR_CANFESTIVAL_MODULE
	depends on CAN && !CAN_FD_MODE
	help
	  Enable the CanFestival CANopen stack, using the Zephyr CAN and timer
	  drivers. The CAN controllers usable by CanFestival are listed in a
	  devicetree node with compatible "canfestival,interfaces" (board overlay),
	  selected by busname; if no such node is given, the single controller from
	  the "zephyr,canbus" chosen node is used. This is an alternative to the
	  canopennode module.

if CANFESTIVAL

config CANFESTIVAL_RX_THREAD_PRIO
	int "CanFestival CAN receive thread priority"
	default 5
	help
	  Priority of the per-port thread blocking on received CAN frames and
	  dispatching them into the CANopen stack.

config CANFESTIVAL_RX_MSGQ_DEPTH
	int "CanFestival RX message queue depth (frames)"
	default 16
	help
	  Number of CAN frames that can be buffered between the CAN interrupt
	  and the receive thread. Size it for the worst-case burst; on overflow
	  incoming frames are dropped.

config CANFESTIVAL_TX_TIMEOUT_MS
	int "CanFestival CAN send timeout (ms)"
	default 100

config CANFESTIVAL_TIMER_THREAD_PRIO
	int "CanFestival timer dispatch thread priority"
	default 4
	help
	  Priority of the thread running TimeDispatch() on timer expiry. Should
	  be at least as high as the receive thread priority.

config CANFESTIVAL_TIMER_STACK_SIZE
	int "CanFestival timer dispatch thread stack size"
	default 1024

config CANFESTIVAL_RX_STACK_SIZE
	int "CanFestival receive thread stack size"
	default 2048

# --- CANopen stack sizing (substituted into the generated config.h) ---------
# The number of CAN buses (MAX_CAN_BUS_ID) is NOT configured here: it is
# deduced from the "canfestival,interfaces" devicetree node count.

config CANFESTIVAL_SDO_MAX_LENGTH_TRANSFER
	int "Maximum SDO transfer length (bytes)"
	default 32

config CANFESTIVAL_SDO_BLOCK_SIZE
	int "SDO block transfer size"
	default 16

config CANFESTIVAL_SDO_MAX_SIMULTANEOUS_TRANSFERS
	int "Maximum simultaneous SDO transfers"
	default 4

config CANFESTIVAL_SDO_TIMEOUT_MS
	int "SDO timeout (ms)"
	default 3000

config CANFESTIVAL_NMT_MAX_NODE_ID
	int "Maximum NMT node ID"
	default 128

config CANFESTIVAL_MAX_NB_TIMER
	int "Maximum number of CANopen timers"
	default 32

config CANFESTIVAL_EMCY_MAX_ERRORS
	int "Maximum number of emergency errors"
	default 8

config CANFESTIVAL_ENABLE_LSS
	bool "Enable CanFestival LSS services"
	default n

if CANFESTIVAL_ENABLE_LSS

config CANFESTIVAL_LSS_TIMEOUT_MS
	int "LSS timeout (ms)"
	default 1000

config CANFESTIVAL_LSS_FS_TIMEOUT_MS
	int "LSS FastScan timeout (ms)"
	default 100

endif # CANFESTIVAL_ENABLE_LSS

endif # CANFESTIVAL
